'use client'
import { useEffect, useState } from 'react'
import Sidebar from '../../components/Sidebar'
import api from '../../lib/api'
import { UserPlus, Search, ChevronRight, Users, X, Download, FileText, Upload } from 'lucide-react'
import Link from 'next/link'

const CHURCH_ID = '00000000-0000-0000-0000-000000000001'
const BRANCH_ID = '00000000-0000-0000-0000-000000000002'

const STATUS_COLORS: Record<string, string> = {
  active:   'bg-emerald-50 text-emerald-700 border-emerald-200',
  inactive: 'bg-gray-100 text-gray-500 border-gray-200',
  visitor:  'bg-amber-50 text-amber-700 border-amber-200',
}

// ── Moved OUTSIDE MembersPage to prevent remount on every keystroke ──
type FormState = {
  first_name: string; last_name: string; phone: string; email: string;
  gender: string; marital_status: string; membership_status: string; occupation: string;
}

function F({ k, l, span = false, form, setForm }: {
  k: keyof FormState; l: string; span?: boolean;
  form: FormState; setForm: (f: FormState) => void;
}) {
  return (
    <div className={span ? 'col-span-2' : ''}>
      <label className="text-xs text-gray-500 font-medium mb-1.5 block">{l}</label>
      <input
        className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm
                   focus:outline-none focus:ring-2 focus:ring-indigo-300 focus:border-indigo-400
                   bg-gray-50/50 transition-all"
        value={form[k]}
        onChange={e => setForm({ ...form, [k]: e.target.value })}
      />
    </div>
  )
}

function S({ k, l, opts, form, setForm }: {
  k: keyof FormState; l: string; opts: [string, string][];
  form: FormState; setForm: (f: FormState) => void;
}) {
  return (
    <div>
      <label className="text-xs text-gray-500 font-medium mb-1.5 block">{l}</label>
      <select
        className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm
                   focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50/50"
        value={form[k]}
        onChange={e => setForm({ ...form, [k]: e.target.value })}
      >
        {opts.map(([v, label]) => <option key={v} value={v}>{label}</option>)}
      </select>
    </div>
  )
}

export default function MembersPage() {
  const [members, setMembers]       = useState<any[]>([])
  const [search, setSearch]         = useState('')
  const [showForm, setShowForm]     = useState(false)
  const [showImport, setShowImport] = useState(false)
  const [loading, setLoading]       = useState(true)
  const [saving, setSaving]         = useState(false)
  const [showExport, setShowExport] = useState(false)
  const [importFile, setImportFile] = useState<File | null>(null)
  const [importRows, setImportRows] = useState<any[]>([])
  const [importing, setImporting]   = useState(false)
  const [importMsg, setImportMsg]   = useState('')
  const [form, setForm] = useState<FormState>({
    first_name: '', last_name: '', phone: '', email: '',
    gender: 'male', marital_status: 'single',
    membership_status: 'active', occupation: ''
  })

  const load = () => {
    setLoading(true)
    api.get('/members/?church_id=' + CHURCH_ID + (search ? '&search=' + search : ''))
      .then(r => setMembers(r.data))
      .finally(() => setLoading(false))
  }

  useEffect(() => { load() }, [search])

  const save = async () => {
    if (!form.first_name || !form.last_name) return alert('First and last name required')
    setSaving(true)
    try {
      await api.post('/members/', { ...form, church_id: CHURCH_ID, branch_id: BRANCH_ID })
      setShowForm(false)
      setForm({
        first_name: '', last_name: '', phone: '', email: '',
        gender: 'male', marital_status: 'single', membership_status: 'active', occupation: ''
      })
      load()
    } finally { setSaving(false) }
  }

  // ── Export CSV ──
  const exportCSV = () => {
    const headers = ['First Name', 'Last Name', 'Phone', 'Email', 'Gender', 'Marital Status', 'Status', 'Occupation', 'Member Since']
    const rows = members.map((m: any) => [
      m.first_name, m.last_name, m.phone || '', m.email || '',
      m.gender || '', m.marital_status || '', m.membership_status || '',
      m.occupation || '', m.membership_date || m.created_at?.slice(0, 10) || ''
    ])
    const csv = [headers, ...rows].map(r => r.map((v: any) => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n')
    const a = document.createElement('a')
    a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv)
    a.download = 'members_' + new Date().toISOString().slice(0, 10) + '.csv'
    a.click()
    setShowExport(false)
  }

  // ── Export Excel ──
  const exportExcel = () => {
    const headers = ['First Name', 'Last Name', 'Phone', 'Email', 'Gender', 'Marital Status', 'Status', 'Occupation']
    const rows = members.map((m: any) => [
      m.first_name, m.last_name, m.phone || '', m.email || '',
      m.gender || '', m.marital_status || '', m.membership_status || '', m.occupation || ''
    ])
    const csv = [headers, ...rows].map(r => r.join('\t')).join('\n')
    const a = document.createElement('a')
    a.href = 'data:application/vnd.ms-excel;charset=utf-8,' + encodeURIComponent(csv)
    a.download = 'members_' + new Date().toISOString().slice(0, 10) + '.xls'
    a.click()
    setShowExport(false)
  }

  // ── Print list ──
  const printList = () => {
    const rows = members.map((m: any) => `
      <tr>
        <td>${m.first_name} ${m.last_name}</td>
        <td>${m.phone || '—'}</td>
        <td>${m.email || '—'}</td>
        <td style="text-transform:capitalize">${m.gender || '—'}</td>
        <td style="text-transform:capitalize">${m.membership_status || '—'}</td>
      </tr>`).join('')
    const win = window.open('', '_blank')
    if (!win) return
    win.document.write(`<!DOCTYPE html><html><head><title>Members List</title>
    <style>body{font-family:Arial,sans-serif;padding:30px;color:#333}
    h1{color:#4338ca;font-size:20px}
    .meta{font-size:12px;color:#888;margin-bottom:20px}
    table{width:100%;border-collapse:collapse}
    th{background:#4338ca;color:#fff;padding:8px 10px;text-align:left;font-size:12px}
    td{padding:8px 10px;font-size:13px;border-bottom:1px solid #eee}
    tr:nth-child(even){background:#f8f8ff}
    .footer{margin-top:30px;font-size:11px;color:#aaa;text-align:center;border-top:1px solid #eee;padding-top:12px}
    </style></head><body>
    <h1>Grace Community Church — Members List</h1>
    <div class="meta">Total: ${members.length} members &nbsp;|&nbsp; Generated: ${new Date().toLocaleDateString('en-KE', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
    <table><thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Gender</th><th>Status</th></tr></thead>
    <tbody>${rows}</tbody></table>
    <div class="footer">Generated by ChurchHub &mdash; Grace Community Church</div>
    </body></html>`)
    win.document.close()
    win.print()
    setShowExport(false)
  }

  // ── Download import template ──
  const downloadTemplate = () => {
    const headers = ['first_name', 'last_name', 'phone', 'email', 'gender', 'marital_status', 'membership_status', 'occupation']
    const sample  = ['Mary', 'Wanjiku', '0722000111', 'mary@example.com', 'female', 'married', 'active', 'Teacher']
    const csv = [headers, sample].map(r => r.join(',')).join('\n')
    const a = document.createElement('a')
    a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv)
    a.download = 'members_import_template.csv'
    a.click()
  }

  // ── Parse uploaded CSV ──
  const handleImportFile = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return
    setImportFile(file)
    setImportMsg('')
    const reader = new FileReader()
    reader.onload = (ev) => {
      const text = ev.target?.result as string
      const lines = text.trim().split('\n')
      const headers = lines[0].split(',').map(h => h.trim().replace(/"/g, ''))
      const rows = lines.slice(1).map(line => {
        const vals = line.split(',').map(v => v.trim().replace(/"/g, ''))
        const obj: any = {}
        headers.forEach((h, i) => { obj[h] = vals[i] || '' })
        return obj
      }).filter(r => r.first_name)
      setImportRows(rows)
    }
    reader.readAsText(file)
  }

  const confirmImport = async () => {
    if (!importRows.length) return
    setImporting(true)
    setImportMsg('')
    let success = 0, failed = 0
    for (const row of importRows) {
      try {
        await api.post('/members/', {
          ...row, church_id: CHURCH_ID, branch_id: BRANCH_ID,
          gender: row.gender || 'male',
          marital_status: row.marital_status || 'single',
          membership_status: row.membership_status || 'active',
        })
        success++
      } catch { failed++ }
    }
    setImporting(false)
    setImportMsg(`✅ ${success} imported${failed ? `, ❌ ${failed} failed` : ''}`)
    load()
  }

  return (
    <div className="flex min-h-screen bg-gray-50">
      <Sidebar />
      <main className="flex-1 min-w-0 pb-24 md:pb-0">

        {/* Header */}
        <header className="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-gray-200
                           px-4 md:px-8 py-3.5 shadow-sm">
          <div className="flex items-center justify-between">
            <div className="ml-12 md:ml-0">
              <div className="flex items-center gap-2 text-xs text-gray-400 mb-0.5">
                <Link href="/" className="hover:text-indigo-600 transition-colors">Dashboard</Link>
                <ChevronRight className="w-3 h-3" />
                <span className="text-gray-600 font-medium">Members</span>
              </div>
              <h1 className="text-gray-900 font-bold text-lg leading-tight">
                Members
                <span className="ml-2 text-sm font-normal text-gray-400">
                  {members.length} registered
                </span>
              </h1>
            </div>
            <div className="flex items-center gap-2">
              {/* Import */}
              <button onClick={() => setShowImport(true)}
                className="flex items-center gap-1.5 border border-gray-200 text-gray-600
                           px-3 py-2 rounded-xl text-sm hover:bg-gray-50 transition-colors">
                <Upload className="w-4 h-4" />
                <span className="hidden sm:inline">Import</span>
              </button>
              {/* Export dropdown */}
              <div className="relative">
                <button onClick={() => setShowExport(!showExport)}
                  className="flex items-center gap-1.5 border border-gray-200 text-gray-600
                             px-3 py-2 rounded-xl text-sm hover:bg-gray-50 transition-colors">
                  <Download className="w-4 h-4" />
                  <span className="hidden sm:inline">Export</span>
                </button>
                {showExport && (
                  <div className="absolute right-0 top-full mt-1 bg-white border border-gray-200
                                  rounded-xl shadow-lg z-50 w-44 overflow-hidden">
                    <button onClick={exportCSV}
                      className="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50
                                 hover:text-indigo-700 flex items-center gap-2 transition-colors">
                      <FileText className="w-4 h-4" /> Export CSV
                    </button>
                    <button onClick={exportExcel}
                      className="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50
                                 hover:text-indigo-700 flex items-center gap-2 transition-colors">
                      <FileText className="w-4 h-4" /> Export Excel
                    </button>
                    <button onClick={printList}
                      className="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50
                                 hover:text-indigo-700 flex items-center gap-2 transition-colors">
                      <FileText className="w-4 h-4" /> Print List
                    </button>
                    <button onClick={downloadTemplate}
                      className="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50
                                 hover:text-indigo-700 flex items-center gap-2 transition-colors border-t border-gray-100">
                      <Download className="w-4 h-4" /> Import Template
                    </button>
                  </div>
                )}
              </div>
              <button onClick={() => setShowForm(true)}
                className="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700
                           text-white px-3 md:px-4 py-2 rounded-xl text-sm font-semibold
                           shadow-sm shadow-indigo-200 transition-all active:scale-95">
                <UserPlus className="w-4 h-4" />
                <span className="hidden sm:inline">Register Member</span>
                <span className="sm:hidden">Register</span>
              </button>
            </div>
          </div>
        </header>

        <div className="p-4 md:p-8 max-w-7xl mx-auto space-y-4">
          <div className="relative">
            <Search className="absolute left-3.5 top-3 w-4 h-4 text-gray-400" />
            <input
              className="w-full pl-10 pr-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm
                         focus:outline-none focus:ring-2 focus:ring-indigo-300 shadow-sm"
              placeholder="Search by name or phone..."
              value={search} onChange={e => setSearch(e.target.value)} />
          </div>

          <div className="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            {loading ? (
              <div className="flex items-center justify-center py-20 gap-3">
                <div className="w-7 h-7 border-2 border-indigo-200 border-t-indigo-600 rounded-full animate-spin" />
                <span className="text-gray-400 text-sm">Loading members...</span>
              </div>
            ) : members.length === 0 ? (
              <div className="py-20 text-center">
                <Users className="w-10 h-10 text-gray-200 mx-auto mb-3" />
                <p className="text-gray-400 text-sm mb-3">No members yet</p>
                <button onClick={() => setShowForm(true)}
                  className="text-indigo-600 text-sm font-semibold hover:text-indigo-800">
                  + Register First Member
                </button>
              </div>
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full min-w-[600px]">
                  <thead className="bg-gray-50 border-b border-gray-100">
                    <tr>
                      {['Name', 'Phone', 'Gender', 'Status', 'Branch', ''].map(h => (
                        <th key={h} className="text-left text-xs text-gray-500 font-semibold
                                               uppercase tracking-wide px-4 py-3">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-50">
                    {members.map((m: any) => (
                      <tr key={m.id} className="hover:bg-indigo-50/30 transition-colors group">
                        <td className="px-4 py-3">
                          <div className="flex items-center gap-2.5">
                            <div className="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center
                                            text-xs font-bold text-indigo-600 shrink-0">
                              {m.first_name?.[0]}{m.last_name?.[0]}
                            </div>
                            <span className="text-sm font-semibold text-gray-800">
                              {m.first_name} {m.last_name}
                            </span>
                          </div>
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-500">{m.phone || '—'}</td>
                        <td className="px-4 py-3 text-sm text-gray-500 capitalize">{m.gender || '—'}</td>
                        <td className="px-4 py-3">
                          <span className={`text-xs px-2.5 py-1 rounded-full border font-medium capitalize
                            ${STATUS_COLORS[m.membership_status] || STATUS_COLORS.inactive}`}>
                            {m.membership_status}
                          </span>
                        </td>
                        <td className="px-4 py-3 text-sm text-gray-400">Nairobi Main</td>
                        <td className="px-4 py-3">
                          <Link href={"/members/" + m.id}
                            className="flex items-center gap-1 text-indigo-600 text-xs font-semibold
                                       hover:text-indigo-800 opacity-0 group-hover:opacity-100
                                       transition-all whitespace-nowrap">
                            View <ChevronRight className="w-3 h-3" />
                          </Link>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>

          {/* Next Step CTA */}
          {members.length > 0 && (
            <div className="flex items-center justify-between bg-indigo-50 border border-indigo-100
                            rounded-2xl px-5 py-3.5">
              <p className="text-sm text-indigo-700 font-medium">
                Next step: Record giving for a member
              </p>
              <Link href="/giving"
                className="flex items-center gap-1.5 bg-indigo-600 text-white px-4 py-2 rounded-xl
                           text-sm font-semibold hover:bg-indigo-700 transition-colors">
                Record Giving <ChevronRight className="w-4 h-4" />
              </Link>
            </div>
          )}
        </div>

        {/* Register Member Modal */}
        {showForm && (
          <div className="fixed inset-0 z-50 flex items-end md:items-center justify-center p-0 md:p-4">
            <div className="absolute inset-0 bg-black/50 backdrop-blur-sm" onClick={() => setShowForm(false)} />
            <div className="relative bg-white w-full md:max-w-lg rounded-t-3xl md:rounded-2xl
                            shadow-2xl max-h-[92vh] overflow-y-auto">
              <div className="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between rounded-t-3xl md:rounded-t-2xl">
                <div>
                  <h2 className="text-base font-bold text-gray-900">Register New Member</h2>
                  <p className="text-xs text-gray-400 mt-0.5">All fields marked * are required</p>
                </div>
                <button onClick={() => setShowForm(false)}
                  className="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100
                             hover:bg-gray-200 transition-colors">
                  <X className="w-4 h-4 text-gray-500" />
                </button>
              </div>
              <div className="p-6">
                <div className="grid grid-cols-2 gap-4">
                  <F k="first_name" l="First Name *" form={form} setForm={setForm} />
                  <F k="last_name"  l="Last Name *"  form={form} setForm={setForm} />
                  <F k="phone"      l="Phone"        form={form} setForm={setForm} />
                  <F k="email"      l="Email"        form={form} setForm={setForm} />
                  <F k="occupation" l="Occupation"   form={form} setForm={setForm} span />
                  <S k="gender"            l="Gender"         opts={[['male','Male'],['female','Female']]}                                               form={form} setForm={setForm} />
                  <S k="marital_status"    l="Marital Status" opts={[['single','Single'],['married','Married'],['widowed','Widowed'],['divorced','Divorced']]} form={form} setForm={setForm} />
                  <S k="membership_status" l="Status"         opts={[['active','Active'],['inactive','Inactive'],['visitor','Visitor']]}                form={form} setForm={setForm} />
                </div>
                <div className="flex gap-3 mt-6">
                  <button onClick={() => setShowForm(false)}
                    className="flex-1 border border-gray-200 text-gray-600 py-3 rounded-xl text-sm
                               font-medium hover:bg-gray-50 transition-colors">Cancel</button>
                  <button onClick={save} disabled={saving}
                    className="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl
                               text-sm font-semibold shadow-sm shadow-indigo-200 transition-all
                               disabled:opacity-50 active:scale-[0.98]">
                    {saving ? 'Saving...' : 'Save Member →'}
                  </button>
                </div>
                <p className="text-center text-xs text-gray-400 mt-3">
                  After saving, you can record their first giving →
                </p>
              </div>
            </div>
          </div>
        )}

        {/* Bulk Import Modal */}
        {showImport && (
          <div className="fixed inset-0 z-50 flex items-end md:items-center justify-center p-0 md:p-4">
            <div className="absolute inset-0 bg-black/50 backdrop-blur-sm" onClick={() => setShowImport(false)} />
            <div className="relative bg-white w-full md:max-w-lg rounded-t-3xl md:rounded-2xl
                            shadow-2xl max-h-[92vh] overflow-y-auto">
              <div className="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between rounded-t-3xl md:rounded-t-2xl">
                <div>
                  <h2 className="text-base font-bold text-gray-900">Bulk Import Members</h2>
                  <p className="text-xs text-gray-400 mt-0.5">Upload a CSV file to import multiple members at once</p>
                </div>
                <button onClick={() => { setShowImport(false); setImportRows([]); setImportMsg('') }}
                  className="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200">
                  <X className="w-4 h-4 text-gray-500" />
                </button>
              </div>
              <div className="p-6 space-y-4">
                <div className="bg-indigo-50 border border-indigo-100 rounded-xl p-4">
                  <p className="text-sm font-semibold text-indigo-800 mb-1">Step 1 — Download template</p>
                  <p className="text-xs text-indigo-600 mb-3">Fill in your members in the template, then upload below.</p>
                  <button onClick={downloadTemplate}
                    className="flex items-center gap-2 bg-white border border-indigo-200 text-indigo-700
                               px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-50 transition-colors">
                    <Download className="w-4 h-4" /> Download CSV Template
                  </button>
                </div>
                <div>
                  <p className="text-sm font-semibold text-gray-700 mb-2">Step 2 — Upload filled CSV</p>
                  <input type="file" accept=".csv"
                    onChange={handleImportFile}
                    className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm bg-gray-50" />
                </div>
                {importRows.length > 0 && (
                  <div>
                    <p className="text-sm font-semibold text-gray-700 mb-2">
                      Preview — {importRows.length} members found
                    </p>
                    <div className="border border-gray-100 rounded-xl overflow-hidden max-h-48 overflow-y-auto">
                      <table className="w-full text-xs">
                        <thead className="bg-gray-50">
                          <tr>
                            <th className="text-left px-3 py-2 text-gray-500">Name</th>
                            <th className="text-left px-3 py-2 text-gray-500">Phone</th>
                            <th className="text-left px-3 py-2 text-gray-500">Status</th>
                          </tr>
                        </thead>
                        <tbody>
                          {importRows.map((r, i) => (
                            <tr key={i} className="border-t border-gray-50">
                              <td className="px-3 py-2 text-gray-800">{r.first_name} {r.last_name}</td>
                              <td className="px-3 py-2 text-gray-500">{r.phone || '—'}</td>
                              <td className="px-3 py-2 text-gray-500 capitalize">{r.membership_status || 'active'}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
                {importMsg && (
                  <div className="px-4 py-3 bg-emerald-50 border border-emerald-200 rounded-xl text-sm text-emerald-700">
                    {importMsg}
                  </div>
                )}
                <div className="flex gap-3">
                  <button onClick={() => { setShowImport(false); setImportRows([]); setImportMsg('') }}
                    className="flex-1 border border-gray-200 text-gray-600 py-3 rounded-xl text-sm font-medium hover:bg-gray-50">
                    Cancel
                  </button>
                  <button onClick={confirmImport} disabled={importing || importRows.length === 0}
                    className="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl
                               text-sm font-semibold disabled:opacity-50 transition-all">
                    {importing ? 'Importing...' : `Import ${importRows.length} Members →`}
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Close export dropdown on outside click */}
        {showExport && (
          <div className="fixed inset-0 z-40" onClick={() => setShowExport(false)} />
        )}
      </main>
    </div>
  )
}